{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.3.4",
  "key": "",
  "description": "__MSG_description_short__",
  "default_locale": "en",
  "minimum_chrome_version": "137",
  "incognito": "split",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "alarms", "declarativeNetRequest", "scripting", "webNavigation", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content/hide.js"], "run_at": "document_start", "all_frames": true }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads-easylist.json" },
      { "id": "ads-adguard-base", "enabled": true, "path": "rules/ads-adguard-base.json" },
      { "id": "iran", "enabled": true, "path": "rules/iran-persianblocker.json" },
      { "id": "cpab-own", "enabled": true, "path": "rules/ads-cpab-own.json" },
      { "id": "trackers", "enabled": true, "path": "rules/trackers-easyprivacy.json" },
      { "id": "trackers-hagezi-light", "enabled": true, "path": "rules/trackers-hagezi-light.json" },
      { "id": "popups-adguard", "enabled": true, "path": "rules/popups-adguard.json" },
      { "id": "widgets-adguard", "enabled": true, "path": "rules/widgets-adguard.json" },
      { "id": "widgets-fanboy-social", "enabled": true, "path": "rules/widgets-fanboy-social.json" },
      { "id": "harmful-hagezi-tif", "enabled": true, "path": "rules/harmful-hagezi-tif.json" },
      { "id": "harmful-badware", "enabled": true, "path": "rules/harmful-badware.json" },
      { "id": "adult-hagezi-nsfw", "enabled": false, "path": "rules/adult-hagezi-nsfw.json" }
    ]
  },
  "web_accessible_resources": [
    { "resources": ["warning/warning.html", "blocked/blocked.html"], "matches": ["<all_urls>"] }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "settings/settings.html"
}
