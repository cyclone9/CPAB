   "eval": "fetch('../rules/LICENSE.MIT-Leakfa.txt').then(r=>r.text()).then(t=>t.split('\\n').slice(0,3).join('|'))",
   "label": "the MIT text ships beside the file",
   "equals": "MIT License||Copyright (c) 2026 Leakfa"
  },
  {
   "eval": "document.getElementById('dataleak-desc').textContent.includes('Have I Been Pwned')&&document.getElementById('dataleak-desc').textContent.includes('Leakfa')",
   "label": "the switch description names both sources",
   "equals": true
  },
  {
   "eval": "[...document.querySelectorAll('#credits .credit-title')].map(e=>e.textContent).includes('Have I Been Pwned breaches')",
   "label": "credited in About",
   "equals": true
  },
  {
   "eval": "(document.getElementById('dataleak').scrollIntoView({block:'center',behavior:'instant'}),'scrolled')"
  },
  {
   "click": "#dataleak",
   "settle": 800
  },
  {
   "sw": "chrome.storage.local.get('settings').then(s=>s.settings.dataLeak)",
   "label": "the switch saves off",
   "equals": false
  },
  {
   "click": "#dataleak",
   "settle": 800
  },
  {
   "sw": "chrome.storage.local.get('settings').then(s=>s.settings.dataLeak)",
   "label": "and on again",
   "equals": true
  }
 ]
